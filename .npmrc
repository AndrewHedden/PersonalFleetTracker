# Make pnpm install real (non-symlinked) node_modules in each workspace.
#
# Required for AWS Amplify Hosting's Next.js SSR runtime: Amplify expects to
# find `next` directly under web/node_modules when it bundles the deployment
# package. pnpm's default isolated/symlinked layout puts `next` in a hoisted
# store and symlinks it, which Amplify's deployment packager can't follow.
node-linker=hoisted
